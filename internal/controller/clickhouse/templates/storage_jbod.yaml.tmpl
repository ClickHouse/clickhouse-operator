{{- /* Storage configuration: all disks in a single volume for true JBOD round-robin distribution */}}
{{- /* DiskName is the ClickHouse identifier (hyphens replaced with underscores); Path uses the original name. */}}
storage_configuration:
  disks:
{{- range .AdditionalDisks }}
    {{ .DiskName }}:
      path: {{ .Path }}
{{- end }}
  policies:
    default:
      volumes:
        main:
          disk:
            - default
{{- range .AdditionalDisks }}
            - {{ .DiskName }}
{{- end }}
